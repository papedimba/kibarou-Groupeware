# Copier en .env sur le serveur (jamais versionné, jamais dans public/).
APP_ENV=production
APP_DEBUG=false
APP_URL=https://gw.kibarouconstruction.com
# Sous-répertoire si l'application n'est pas à la racine du domaine (ex. /groupware), sinon vide
APP_BASE_PATH=
# Fuseau d'affichage (le stockage reste en UTC) — à confirmer par Kibarou Construction
APP_TIMEZONE=Africa/Abidjan

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# true en production (HTTPS obligatoire). false uniquement en développement local HTTP.
SESSION_SECURE=true
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_HOURS=12

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@kibarouconstruction.com
MAIL_FROM_NAME="Kibarou Groupware"

AUDIT_RETENTION_DAYS=730

# Installation web sans SSH : générer 48 caractères aléatoires, puis SUPPRIMER après installation.
# Exemple : php -r "echo bin2hex(random_bytes(24));"
INSTALL_TOKEN=
